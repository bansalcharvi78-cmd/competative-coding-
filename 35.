class Solution {
public:
    int searchInsert(vector<int>& nums, int target) {
        int left = 0;
        int right = nums.size() - 1;

        while (left <= right) {
            int mid = left + (right - left) / 2;

            if (nums[mid] == target)
                return mid;

            if (nums[mid] < target)
                left = mid + 1;
            else
                right = mid - 1;
        }

        return left;
    }
}; 

### Approach

* Use **binary search** on the sorted array.
* Compare `nums[mid]` with `target` and adjust `left` or `right`.
* If the target is not found, `left` gives the correct insertion position.

### Complexity

* **Time:** `O(log n)`
* **Space:** `O(1)`
