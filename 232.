class MyQueue {
public:
    stack<int> s1, s2;

    MyQueue() {
        
    }

    void push(int x) {
        s1.push(x);
    }
    int pop() {
        peek();
        int val = s2.top();
        s2.pop();
        return val;
    }

    int peek() {
        if (s2.empty()) {
            while (!s1.empty()) {
                s2.push(s1.top());
                s1.pop();
            }
        }
        return s2.top();
    }

    bool empty() {
        return s1.empty() && s2.empty();
    }
};

### Approach

* Implement a **queue using two stacks**, `s1` and `s2`.
* `push()` adds elements to `s1`.
* For `pop()` and `peek()`, transfer elements from `s1` to `s2` when `s2` is empty, reversing the order to maintain **FIFO**.
* `empty()` checks whether both stacks are empty.

### Complexity

* **Push:** `O(1)`
* **Pop:** `O(1)` amortized
* **Peek:** `O(1)` amortized
* **Space:** `O(n)`
